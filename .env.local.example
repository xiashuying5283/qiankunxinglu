# ============================================
# 占卜应用环境变量配置说明
# ============================================
# 开发环境：复制此文件为 .env.local 并填写实际值
# 生产环境：在服务器上设置环境变量或使用 .env.local

# ============================================
# Supabase 数据库配置（必需）
# ============================================
# 从 Supabase 项目设置 > API 中获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ============================================
# LLM API 配置（AI 功能必需）
# ============================================
# 支持 OpenAI 或兼容 OpenAI 格式的 API
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ============================================
# 应用配置（可选）
# ============================================
# 应用域名，部署时改为实际域名
# APP_URL=https://your-domain.com

# ============================================
# OAuth 登录配置（可选）
# ============================================
# GitHub OAuth 配置
# 回调地址:
#   开发环境: http://localhost:5000/api/auth/oauth/github/callback
#   生产环境: https://your-domain.com/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth 配置（国内服务器不可用）
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# 邮件服务配置（可选，用于密码重置）
# ============================================
# RESEND_API_KEY=your-resend-api-key

# ============================================
# JWT 配置（可选，已有默认值）
# ============================================
# JWT_SECRET=divination-app-secret-key-2024
